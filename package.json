{
  "name": "x7finance",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*",
    "tooling/*"
  ],
  "scripts": {
    "all": "bun run --elide-lines=0 clean && bun install && TURBO_LOG_ORDER=stream turbo run build lint typecheck format --output-logs=full",
    "build": "turbo build",
    "build:setup": "turbo build --filter='./packages/*'",
    "check:cycles": "madge --circular --extensions ts,tsx packages/*/src apps/*/src",
    "checks": "TURBO_LOG_ORDER=stream turbo format lint typecheck --continue --output-logs=full",
    "clean": "turbo run clean && bun run --elide-lines=0 scripts/infra/clean.mjs node_modules bun.lock",
    "clean:workspace": "turbo run clean && bun run --elide-lines=0 scripts/infra/clean.mjs .turbo dist .next .cache",
    "dev": "turbo watch dev --continue",
    "e2e": "turbo run e2e --filter=@x7/e2e",
    "format": "turbo run format --continue",
    "format:fix": "turbo run format:fix --continue",
    "lint": "turbo run lint --continue",
    "lint:fix": "turbo run lint --continue -- --fix",
    "lint:md": "markdownlint --fix **/*.md --ignore '**/node_modules/**' --ignore '**/CHANGELOG.md'",
    "lint:package-json": "sort-package-json package.json {apps,packages,tooling}/*/package.json",
    "manypkg": "manypkg check",
    "prepare": "husky && bun run ruler:apply",
    "ruler:apply": "ruler apply --agents claude,cursor,codex",
    "start": "turbo start",
    "test": "turbo test",
    "typecheck": "turbo typecheck"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx}": [
      "oxfmt --config ./tooling/oxfmt/.oxfmtrc.json",
      "oxlint --fix"
    ]
  },
  "overrides": {
    "react": "^19.0.4",
    "react-dom": "^19.0.4",
    "react-hook-form": "^7.72.0"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@commitlint/types": "^20.5.0",
    "@intellectronica/ruler": "^0.3.37",
    "@manypkg/cli": "^0.25.1",
    "@typescript/native-preview": "^7.0.0-dev.20260323.1",
    "@wayofdev/markdownlint-config": "^4.0.0",
    "husky": "^9.1.7",
    "is-ci": "^4.1.0",
    "lint-staged": "^16.4.0",
    "madge": "8.0.0",
    "markdownlint": "^0.40.0",
    "markdownlint-cli": "^0.48.0",
    "oxfmt": "^0.41.0",
    "oxlint": "^1.56.0",
    "rimraf": "^6.1.3",
    "sort-package-json": "^3.6.1",
    "turbo": "^2.8.20",
    "typescript": "^5.9.3",
    "vercel": "^50.35.0"
  },
  "packageManager": "bun@1.3.11",
  "engines": {
    "node": ">=22"
  }
}
