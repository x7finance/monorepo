{
  "$schema": "https://raw.githubusercontent.com/oxc-project/oxc/main/npm/oxlint/configuration_schema.json",
  "categories": {
    "correctness": "warn",
    "suspicious": "warn",
    "pedantic": "off",
    "perf": "warn",
    "style": "off",
    "restriction": "off",
    "nursery": "off"
  },
  "plugins": ["typescript"],
  "env": {
    "browser": true,
    "node": true,
    "es2024": true
  },
  "rules": {
    "no-await-in-loop": "off",
    "no-unused-vars": "warn",
    "no-console": "off",
    "no-debugger": "error",
    "eqeqeq": "warn",
    "typescript/no-explicit-any": "warn",
    "typescript/no-non-null-assertion": "warn",
    "no-underscore-dangle": "off",
    "oxc/no-map-spread": "off"
  },
  "ignorePatterns": [
    "node_modules/**",
    "dist/**",
    "build/**",
    ".turbo/**",
    "*.config.js",
    "*.config.mjs",
    "*.config.ts"
  ]
}
