{
  "$schema": "../../node_modules/oxfmt/configuration_schema.json",
  "printWidth": 80,
  "singleQuote": false,
  "jsxSingleQuote": false,
  "semi": false,
  "trailingComma": "es5",
  "tabWidth": 2,
  "ignorePatterns": [
    "**/node_modules/**",
    "**/.next/**",
    "**/dist/**",
    "**/build/**",
    "**/.turbo/**",
    "**/coverage/**",
    "**/*.min.js",
    "**/*.config.js",
    "**/*.config.ts",
    "**/artifacts/**",
    "**/contracts/**"
  ],
  "experimentalSortImports": {
    "newlinesBetween": true,
    "ignoreCase": true,
    "internalPattern": ["@x7/", "~/"],
    "groups": [
      ["builtin", "builtin-type"],
      ["external", "external-type"],
      ["internal", "internal-type"],
      ["parent", "parent-type"],
      ["sibling", "sibling-type"],
      ["index", "index-type"],
      ["side-effect", "side-effect-style"]
    ]
  }
}
