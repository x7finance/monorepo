{
  "name": "@x7/org",
  "version": "0.0.1",
  "homepage": "https://www.x7finance.org",
  "repository": "x7/monorepo",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "analyze": "cross-env BUNDLE_ANALYZE=both next build",
    "build": "next build",
    "clean": "git clean -xdf .turbo node_modules .next",
    "dev": "test -f $HOME/.portless/ca.pem && export NODE_EXTRA_CA_CERTS=$HOME/.portless/ca.pem; portless x7-org bun run --elide-lines=0 next dev --turbopack",
    "dev:http": "portless x7-org bun run --elide-lines=0 next dev --turbopack",
    "format": "oxfmt --check --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "format:fix": "oxfmt --write --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "lint": "oxlint src/",
    "preview": "next build && next start",
    "start": "next start",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@docsearch/react": "^4.6.3",
    "@hookform/resolvers": "^5.4.0",
    "@markdoc/markdoc": "^0.5.8",
