    "@x7/smart-order-router": "workspace:*",
    "@x7/ui": "workspace:*",
    "@x7/utils": "workspace:*",
    "@xmtp/xmtp-js": "^13.0.4",
    "alchemy-sdk": "^3.6.5",
    "babel-plugin-react-compiler": "1.0.0",
    "cross-env": "^10.1.0",
    "d3-scale": "^4.0.2",
