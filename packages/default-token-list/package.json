{
  "name": "@x7/default-token-list",
  "version": "0.0.1",
  "description": "The Xchange default token list",
  "license": "MIT",
  "exports": {
    ".": {
      "import": "./build/xchange-default.tokenlist.json",
      "require": "./build/xchange-default.tokenlist.json",
      "default": "./build/xchange-default.tokenlist.json"
    }
  },
  "main": "build/xchange-default.tokenlist.json",
  "files": [
    "build/xchange-default.tokenlist.json"
  ],
  "scripts": {
    "build": "rimraf build && mkdir -p build && node src/write.js",
    "build:refresh": "node src/write.js && cp build/xchange-default.tokenlist.json src/tokenlist.snapshot.json",
    "clean": "git clean -xdf .turbo node_modules build",
    "format": "oxfmt --check --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "format:fix": "oxfmt --write --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "test": "mocha"
  },
  "dependencies": {
    "viem": "^2.55.8"
  },
  "devDependencies": {
    "@x7/token-lists": "workspace:*",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "chai": "^6.2.2",
    "dotenv": "^17.4.2",
    "mocha": "^11.7.6",
    "oxlint": "^1.75.0"
  }
}
