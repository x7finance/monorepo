{
  "name": "@x7/default-token-list",
  "version": "0.0.1",
  "description": "The Xchange default token list",
  "license": "MIT",
  "main": "build/xchange-default.tokenlist.json",
  "files": [
    "build/xchange-default.tokenlist.json"
  ],
  "scripts": {
    "build": "rimraf build && mkdir -p build && node src/write.js",
    "clean": "git clean -xdf .turbo node_modules build",
    "format": "oxfmt --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "format:fix": "oxfmt --write --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "test": "mocha"
  },
  "dependencies": {
    "viem": "^2.23.13"
  },
  "devDependencies": {
    "@x7/token-lists": "workspace:*",
    "ajv": "^6.12.3",
    "chai": "^4.2.0",
    "dotenv": "^16.4.7",
    "mocha": "^8.0.1",
    "oxlint": "^0.16.6"
  }
}
