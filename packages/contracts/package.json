{
  "name": "@x7/contracts",
  "version": "0.0.1",
  "description": "Contracts for building applications on top of Xchange",
  "license": "UNLICENSED",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    },
    "./artifacts/*": "./artifacts/*"
  },
  "scripts": {
    "build": "hardhat compile && tsc",
    "clean": "git clean -xdf .turbo artifacts node_modules cache dist",
    "lint": "oxlint src/",
    "typecheck": "tsgo --noEmit --emitDeclarationOnly false"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ignition": "^0.15.16",
    "@nomicfoundation/hardhat-toolbox-viem": "^3.0.0",
    "@nomicfoundation/hardhat-viem": "^2.1.0",
    "@nomicfoundation/ignition-core": "^0.15.15",
    "@x7/tsconfig": "workspace:*",
    "base64-sol": "1.0.1",
    "decimal.js": "^10.5.0",
    "dotenv": "^16.4.7",
    "hardhat": "^2.22.19",
    "hardhat-viem": "^1.0.0",
    "oxlint": "^0.16.6",
    "typescript": "^5.8.2",
    "viem": "^2.23.13"
  }
}
