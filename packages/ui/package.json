{
  "name": "@x7/ui",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsgo",
    "clean": "git clean -xdf .turbo node_modules dist",
    "dev": "tsgo --watch",
    "format": "oxfmt --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "format:fix": "oxfmt --write --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.1.0",
    "motion": "^12.29.2",
    "@react-spring/web": "^9.7.5",
    "@tanstack/react-table": "^8.21.2",
    "@x7/css": "workspace:*",
    "@x7/icons": "workspace:*",
    "@x7/sdk": "workspace:*",
    "@x7/utils": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cmdk": "0.2.0",
    "date-fns": "^3.6.0",
    "lucide-react": "^0.483.0",
    "next": "15.2.3",
    "nextjs-darkmode": "^1.0.10",
    "react-hook-form": "^7.54.2",
    "react-virtualized-auto-sizer": "^1.0.25",
    "react-window": "^1.8.11",
    "recharts": "2.15.1",
    "sonner": "^2.0.1",
    "use-clipboard-copy": "^0.2.0",
    "use-resize-observer": "^9.1.0",
    "vaul": "^1.1.2",
    "viem": "^2.23.13",
    "wagmi": "^2.14.15",
    "zod": "^3.24.1",
    "zustand": "5.0.3"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^6.2.0",
    "@testing-library/react": "^14.1.2",
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@types/react-virtualized-auto-sizer": "^1.0.4",
    "@types/react-window": "^1.8.8",
    "@vitejs/plugin-react": "^4.2.1",
    "@x7/dexie": "workspace:*",
    "@x7/tsconfig": "workspace:*",
    "jsdom": "^24.0.0",
    "oxlint": "^0.16.6",
    "tailwindcss": "^4.0.9",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^5.8.2",
    "vitest": "^1.2.0"
  }
}
