{
  "name": "@x7/ui",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./*": {
      "types": "./dist/*.d.ts",
      "default": "./dist/*.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .turbo node_modules dist",
    "dev": "tsc --watch",
    "format": "oxfmt --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "format:fix": "oxfmt --write --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@base-ui/react": "^1.6.0",
    "@react-spring/web": "^10.1.2",
    "@tanstack/react-table": "^8.21.3",
    "@x7/css": "workspace:*",
    "@x7/icons": "workspace:*",
    "@x7/sdk": "workspace:*",
    "@x7/utils": "workspace:*",
    "class-variance-authority": "^0.7.1",
    "cmdk": "1.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^1.25.0",
    "motion": "^12.42.2",
    "next": "16.3.0-preview.8",
    "nextjs-darkmode": "^1.0.10",
    "react-hook-form": "^7.82.0",
    "react-virtualized-auto-sizer": "^2.0.3",
    "react-window": "^2.3.0",
    "recharts": "3.8.0",
    "sonner": "^2.0.7",
    "use-clipboard-copy": "^0.2.0",
    "use-resize-observer": "^9.1.0",
    "vaul": "^1.1.2",
    "viem": "^2.55.7",
    "wagmi": "^3.7.4",
    "zod": "^4.4.3",
    "zustand": "5.0.12"
  },
  "devDependencies": {
    "@testing-library/jest-dom": "^7.0.0",
    "@testing-library/react": "^16.3.2",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "@x7/dexie": "workspace:*",
    "@x7/tsconfig": "workspace:*",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "tailwindcss": "^4.3.3",
    "tailwindcss-animate": "^1.0.7",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
