{
  "name": "@x7/icons",
  "version": "0.0.1",
  "private": true,
  "description": "Icon library and components for X7 Finance",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsgo",
    "clean": "git clean -xdf .turbo node_modules dist",
    "dev": "tsgo --watch",
    "format": "oxfmt --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "format:fix": "oxfmt --write --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "lint": "oxlint src/",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@x7/css": "workspace:*",
    "lucide-react": "^1.0.1"
  },
  "devDependencies": {
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@x7/tsconfig": "workspace:*",
    "oxlint": "^1.56.0",
    "typescript": "^6.0.2"
  }
}
