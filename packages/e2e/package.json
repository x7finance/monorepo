    "@synthetixio/synpress": "^4.1.2",
    "@types/node": "^22.20.1",
    "@x7/tsconfig": "workspace:*",
    "axios": "^1.18.1",
    "dotenv": "^17.4.2",
    "oxlint": "^1.75.0"
  }
}
