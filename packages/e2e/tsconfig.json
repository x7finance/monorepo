{
  "compilerOptions": {
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "skipDefaultLibCheck": true,
    "target": "ES2020",
    "allowJs": true,
    "paths": {
      "@/*": ["./lib/*"]
    },
    "incremental": true,
    "tsBuildInfoFile": ".turbo/.tsbuildinfo"
  }
}
