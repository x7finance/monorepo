    "lodash.flatmap": "^4.5.0",
    "viem": "^2.23.13"
  },
  "devDependencies": {
    "@types/lodash.flatmap": "^4.5.9",
    "@types/node": "^22.13.10",
    "@x7/eslint-config": "workspace:*",
    "@x7/prettier-config": "workspace:*",
    "@x7/tsconfig": "workspace:*",
    "typescript": "catalog:"
  }
