{
  "name": "@x7/router",
  "version": "0.0.1",
  "description": "Swap routing logic for Xchange DEX",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsgo",
    "clean": "git clean -xdf .turbo node_modules dist",
    "dev": "tsgo --watch",
    "format": "oxfmt --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "format:fix": "oxfmt --write --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "lint": "oxlint src/",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@x7/contracts": "workspace:*",
    "@x7/sdk": "workspace:*",
    "@x7/tines": "workspace:*",
    "@x7/utils": "workspace:*",
    "date-fns": "^3.6.0",
    "lodash.flatmap": "^4.5.0",
    "viem": "^2.45.1"
  },
  "devDependencies": {
    "@types/lodash.flatmap": "^4.5.9",
    "@types/node": "^22.19.8",
    "@x7/tsconfig": "workspace:*",
    "oxlint": "^0.16.12",
    "typescript": "^5.9.3"
  }
}
