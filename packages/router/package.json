{
  "name": "@x7/router",
  "version": "0.0.1",
  "description": "Swap routing logic for Xchange DEX",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsgo",
    "clean": "git clean -xdf .turbo node_modules dist",
    "dev": "tsgo --watch",
    "format": "oxfmt --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "format:fix": "oxfmt --write --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "lint": "oxlint src/",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@x7/contracts": "workspace:*",
    "@x7/sdk": "workspace:*",
    "@x7/tines": "workspace:*",
    "@x7/utils": "workspace:*",
    "date-fns": "^4.1.0",
    "lodash.flatmap": "^4.5.0",
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@types/lodash.flatmap": "^4.5.9",
    "@types/node": "^22.19.11",
    "@x7/tsconfig": "workspace:*",
    "oxlint": "^1.56.0",
    "typescript": "^6.0.2"
  }
}
