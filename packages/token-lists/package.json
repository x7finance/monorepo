{
  "name": "@x7/token-lists",
  "version": "0.0.1",
  "description": "The Token Lists specification",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./schema": "./dist/tokenlist.schema.json"
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsgo && mkdir -p dist && cp src/tokenlist.schema.json dist/",
    "clean": "git clean -xdf .turbo node_modules dist",
    "dev": "tsgo --watch",
    "format": "oxfmt --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "format:fix": "oxfmt --write --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "lint": "oxlint src/",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@x7/tsconfig": "workspace:*",
    "husky": "^9.1.7",
    "oxlint": "^0.16.6",
    "typescript": "^5.8.2"
  }
}
