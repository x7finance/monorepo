{
  "name": "@x7/css",
  "version": "0.0.1",
  "description": "Shared CSS utilities and Tailwind helpers for X7 Finance",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": ["dist", "src"],
  "scripts": {
    "build": "tsgo",
    "clean": "git clean -xdf .turbo node_modules dist",
    "dev": "tsgo --watch",
    "lint": "oxlint src/",
    "typecheck": "tsgo --noEmit"
  },
  "devDependencies": {
    "@types/react": "^19.0.8",
    "@types/react-dom": "^19.0.3",
    "@x7/tsconfig": "workspace:*",
    "clsx": "^2.1.1",
    "oxlint": "^0.16.6",
    "tailwind-merge": "^3.0.2",
    "tailwindcss": "^4.0.9",
    "typescript": "^5.8.2"
  }
}
