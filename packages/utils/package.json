{
  "name": "@x7/utils",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsgo",
    "clean": "git clean -xdf .turbo node_modules dist",
    "dev": "tsgo --watch",
    "format": "oxfmt --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "format:fix": "oxfmt --write --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "lint": "oxlint src/",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "big.js": "^6.2.2",
    "decimal.js-light": "^2.5.1",
    "numeral": "^2.0.6",
    "pino": "^9.14.0",
    "tiny-invariant": "^1.3.3",
    "viem": "^2.45.1"
  },
  "devDependencies": {
    "@types/big.js": "^6.2.2",
    "@types/numeral": "^2.0.5",
    "@types/react": "^19.2.10",
    "@types/react-dom": "^19.2.3",
    "@x7/tsconfig": "workspace:*",
    "oxlint": "^0.16.12",
    "typescript": "^5.9.3",
    "zod": "^3.25.76"
  }
}
