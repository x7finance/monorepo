{
  "name": "@x7/utils",
  "version": "0.0.1",
  "private": true,
  "license": "MIT",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .turbo node_modules dist",
    "dev": "tsc --watch",
    "format": "oxfmt --check --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "format:fix": "oxfmt --write --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "big.js": "^7.0.1",
    "decimal.js-light": "^2.5.1",
    "numeral": "^2.0.6",
    "pino": "^10.3.1",
    "tiny-invariant": "^1.3.3",
    "viem": "^2.55.7"
  },
  "devDependencies": {
    "@types/big.js": "^7.0.0",
    "@types/numeral": "^2.0.5",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@x7/tsconfig": "workspace:*",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10",
    "zod": "^4.4.3"
  }
}
