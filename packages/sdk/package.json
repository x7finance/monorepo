{
  "name": "@x7/sdk",
  "version": "0.0.1",
  "description": "SDK's for building applications on top of Xchange",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsgo",
    "clean": "git clean -xdf .turbo node_modules dist",
    "dev": "tsgo --watch",
    "format": "oxfmt --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "format:fix": "oxfmt --write --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^2.2.0",
    "@x7/contracts": "workspace:*",
    "@x7/utils": "workspace:*",
    "tiny-invariant": "^1.3.3",
    "viem": "^2.55.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.1",
    "@x7/tsconfig": "workspace:*",
    "dotenv": "^17.4.2",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
