{
  "name": "@x7/sdk",
  "version": "0.0.1",
  "description": "SDK's for building applications on top of Xchange",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./src/index.ts"
    }
  },
  "scripts": {
    "build": "tsc",
    "clean": "git clean -xdf .turbo node_modules dist",
    "dev": "tsc --watch",
    "format": "prettier --check . --ignore-path ../../.gitignore",
    "lint": "eslint",
    "typecheck": "tsc --noEmit"
  },
  "prettier": "@x7/prettier-config",
  "dependencies": {
    "@noble/curves": "^1.6.0",
    "@x7/contracts": "workspace:*",
    "@x7/utils": "workspace:*",
    "tiny-invariant": "^1.3.3",
    "viem": "^2.23.13"
  },
  "devDependencies": {
    "@types/node": "^22.13.10",
    "@x7/eslint-config": "workspace:*",
    "@x7/prettier-config": "workspace:*",
    "@x7/tsconfig": "workspace:*",
    "dotenv": "^16.4.7",
    "eslint": "catalog:",
    "typescript": "catalog:"
  }
}
