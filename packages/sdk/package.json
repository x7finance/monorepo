{
  "name": "@x7/sdk",
  "version": "0.0.1",
  "description": "SDK's for building applications on top of Xchange",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsgo",
    "clean": "git clean -xdf .turbo node_modules dist",
    "dev": "tsgo --watch",
    "format": "oxfmt --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "format:fix": "oxfmt --write --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "lint": "oxlint src/",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@noble/curves": "^1.9.7",
    "@x7/contracts": "workspace:*",
    "@x7/utils": "workspace:*",
    "tiny-invariant": "^1.3.3",
    "viem": "^2.46.2"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "@x7/tsconfig": "workspace:*",
    "dotenv": "^17.3.1",
    "oxlint": "^1.48.0",
    "typescript": "^5.9.3"
  }
}
