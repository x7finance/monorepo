{
  "name": "@x7/smart-order-router",
  "version": "0.0.1",
  "description": "Xchange Smart Order Router",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsgo",
    "clean": "git clean -xdf .turbo node_modules dist",
    "dev": "tsgo --watch",
    "format": "oxfmt --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "format:fix": "oxfmt --write --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@x7/contracts": "workspace:*",
    "@x7/default-token-list": "workspace:*",
    "@x7/sdk": "workspace:*",
    "@x7/token-lists": "workspace:*",
    "@x7/utils": "workspace:*",
    "async-retry": "^1.3.3",
    "await-timeout": "^1.1.1",
    "axios": "^1.18.1",
    "graphql": "^17.0.2",
    "graphql-request": "^7.4.0",
    "lodash": "^4.18.1",
    "mnemonist": "^0.40.4",
    "node-cache": "^5.1.2",
    "stats-lite": "^2.2.0",
    "viem": "^2.55.7"
  },
  "devDependencies": {
    "@types/async-retry": "^1.4.9",
    "@types/await-timeout": "^0.3.4",
    "@types/lodash": "^4.17.24",
    "@types/stats-lite": "^2.2.2",
    "@x7/tsconfig": "workspace:*",
    "dotenv": "^17.4.2",
    "hardhat": "^2.29.0",
    "oxlint": "^1.75.0",
    "typescript": "^7.0.2",
    "vitest": "^4.1.10"
  }
}
