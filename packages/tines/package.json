{
  "name": "@x7/tines",
  "version": "0.0.1",
  "private": true,
  "description": "AMM pool math and liquidity calculations for X7 Finance",
  "license": "MIT",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsgo",
    "clean": "git clean -xdf .turbo node_modules dist",
    "dev": "tsgo --watch",
    "format": "oxfmt --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "format:fix": "oxfmt --write --config ../../tooling/oxfmt/.oxfmtrc.json src/",
    "lint": "oxlint src/",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:watch": "vitest watch",
    "typecheck": "tsgo --noEmit"
  },
  "dependencies": {
    "@x7/utils": "workspace:*",
    "seedrandom": "^3.0.5",
    "viem": "^2.47.6"
  },
  "devDependencies": {
    "@types/node": "^22.19.11",
    "@types/seedrandom": "^3.0.8",
    "@x7/tsconfig": "workspace:*",
    "oxlint": "^1.56.0",
    "typescript": "^6.0.2",
    "vitest": "^4.1.1"
  }
}
